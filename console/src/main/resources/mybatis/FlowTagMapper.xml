<!-- t_object table all fields -->
<sql id="Base_Column_List_Ext" >
	id, app_code, name, code, parent_code, access_type, path, created_at, created_by, updated_at, updated_by, deleted
</sql>

<select id="queryTagList" resultMap="BaseResultMap" parameterType="net.somta.juggle.console.interfaces.param.flow.FlowTagQueryParam">
	select <include refid="Base_Column_List_Ext" />
	from t_flow_tag
	where 1=1 and deleted=0
	<if test="code != null and code != ''">
		and code = #{code}
	</if>
	and ((access_type = 'public') or (access_type = 'private' and created_by = #{ownerId}))
	and app_code = #{appCode}
</select>

